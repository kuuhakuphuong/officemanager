# Mau cau hinh chay CUC BO (npm start), khong dung docker compose
# cp .env.example .env

# local: du lieu JSON tren may (khong can CSDL)
# mysql: ket noi MySQL 8.0.16+ (trung tam QLToaNha_BCNF)
DATA_MODE=local
PORT=3000
HOST=127.0.0.1

# MySQL (khi DATA_MODE=mysql)
DB_SERVER=localhost
DB_PORT=3306
DB_DATABASE=QLToaNha_BCNF
DB_USER=root
DB_PASSWORD=replace-with-a-local-secret

