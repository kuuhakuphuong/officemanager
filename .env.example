# HTTP server
PORT=3000

# "local" stores development records in data/local-db.json.
# "sqlserver" uses the TV3 BCNF schema. TV4 transactions require TV4 types/procedures and TV5 triggers.
DATA_MODE=local

# SQL Server configuration (central mode and default TV7 site credentials)
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=QLToaNha_BCNF
DB_USER=your-sql-login
DB_PASSWORD=replace-with-a-local-secret
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# TV7 read-only lookup. Defaults to the DB_* SQL server/login above and
# QLToaNha_Site1, QLToaNha_Site2, QLToaNha_Site3 database names.
# Override per site if the fragments are on separate servers or logins.
# TV7_SITE1_SERVER=localhost
# TV7_SITE1_PORT=1433
# TV7_SITE1_DATABASE=QLToaNha_Site1
# TV7_SITE1_USER=read-only-login
# TV7_SITE1_PASSWORD=replace-with-a-local-secret
# Repeat with TV7_SITE2_ and TV7_SITE3_ as needed.
# TV7_SITE1_ENCRYPT=false
# TV7_SITE1_TRUST_SERVER_CERTIFICATE=true

# Defaults to mongodb://127.0.0.1:27017 and QuanLyToaNha.
# TV7_MONGO_URI=mongodb://127.0.0.1:27017
# TV7_MONGO_DATABASE=QuanLyToaNha
